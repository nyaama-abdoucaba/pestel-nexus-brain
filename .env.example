# PostgreSQL local + pgAdmin
POSTGRES_DB=pestel
POSTGRES_USER=pestel
POSTGRES_PASSWORD=pestel_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pestel:pestel_dev_password@localhost:5432/pestel
PGADMIN_DEFAULT_EMAIL=admin@pestel.local
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# LinkedIn Comment Runtime
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT_SECONDS=60
LLM_TRANSPORT=ollama_native
# Vide = on ne force pas. Obligatoire à false sur un modèle à raisonnement
# (qwen3.5:9b), sinon le champ content revient vide. Vérifier avec
# python -m app.linkedin_comments.check_ollama_format avant de changer.
OLLAMA_THINK=false
COMMENT_ANALYSIS_MAX_TOKENS=1200
COMMENT_WRITER_MAX_TOKENS=700
COMMENT_JUDGE_MAX_TOKENS=800
LOG_LEVEL=INFO
